# Copy this file to ".env" and put your real keys there.
# .env is in .gitignore, so your keys never reach git.
# You only need the key for the provider you choose in config.yaml.

# Gemini (default chat, free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Groq (optional, free tier): https://console.groq.com/keys
GROQ_API_KEY=your-key-here

# Claude (optional, paid): https://console.anthropic.com/
ANTHROPIC_API_KEY=your-key-here

# Ollama runs locally and needs no key.
